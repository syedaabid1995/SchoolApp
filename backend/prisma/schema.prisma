model StudentTransportAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  routeId    String    @map("route_id") @db.Uuid
  vehicleId  String?   @map("vehicle_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  droppedAt  DateTime? @map("dropped_at")
  active     Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([active])
  @@map("student_transport_assignments")
}

model Homework {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  classId        String    @map("class_id") @db.Uuid
  sectionId      String    @map("section_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  homeworkDate   DateTime  @map("homework_date")
  submissionDate DateTime  @map("submission_date")
  marks          Decimal   @db.Decimal(10, 2)
  description    String
  attachmentUrl  String?   @map("attachment_url")
  attachmentName String?   @map("attachment_name")
  evaluationDate DateTime? @map("evaluation_date")
  createdById    String    @map("created_by_id") @db.Uuid
  evaluatedById  String?   @map("evaluated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("HomeworkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  evaluatedBy User?                @relation("HomeworkEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: SetNull)
  evaluations HomeworkEvaluation[]

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([createdById])
  @@index([evaluatedById])
  @@map("homeworks")
}

model HomeworkEvaluation {
  id               String                   @id @default(uuid()) @db.Uuid
  schoolId         String                   @map("school_id") @db.Uuid
  homeworkId       String                   @map("homework_id") @db.Uuid
  studentId        String                   @map("student_id") @db.Uuid
  marks            Decimal?                 @db.Decimal(10, 2)
  comments         String?
  qualityStatus    HomeworkQualityStatus    @default(GOOD) @map("quality_status")
  completionStatus HomeworkCompletionStatus @default(COMPLETED) @map("completion_status")
  evaluationDate   DateTime                 @map("evaluation_date")
  evaluatedById    String                   @map("evaluated_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluatedBy User     @relation("HomeworkEvaluationEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: Restrict)

  @@unique([homeworkId, studentId])
  @@index([schoolId])
  @@index([homeworkId])
  @@index([studentId])
  @@index([evaluatedById])
  @@index([completionStatus])
  @@map("homework_evaluations")
}

model LibraryBookCategory {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books  LibraryBook[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("library_book_categories")
}

model LibraryBook {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  title         String
  bookNumber    String?  @map("book_number")
  isbnNumber    String?  @map("isbn_number")
  publisherName String?  @map("publisher_name")
  authorName    String?  @map("author_name")
  rackNumber    String?  @map("rack_number")
  quantity      Int      @default(1)
  price         Decimal? @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category LibraryBookCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subject  Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  issues   LibraryIssue[]

  @@unique([schoolId, bookNumber])
  @@unique([schoolId, isbnNumber])
  @@index([schoolId])
  @@index([categoryId])
  @@index([subjectId])
  @@map("library_books")
}

model LibraryMember {
  id         String            @id @default(uuid()) @db.Uuid
  schoolId   String            @map("school_id") @db.Uuid
  memberType LibraryMemberType @map("member_type")
  memberCode String            @map("member_code")
  studentId  String?           @map("student_id") @db.Uuid
  staffId    String?           @map("staff_id") @db.Uuid
  fullName   String            @map("full_name")
  email      String?
  phone      String?
  photoUrl   String?           @map("photo_url")
  active     Boolean           @default(true)
  canceledAt DateTime?         @map("canceled_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff   TeacherProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  issues  LibraryIssue[]

  @@unique([schoolId, memberType, memberCode])
  @@index([schoolId])
  @@index([studentId])
  @@index([staffId])
  @@index([active])
  @@map("library_members")
}

model LibraryIssue {
  id           String             @id @default(uuid()) @db.Uuid
  schoolId     String             @map("school_id") @db.Uuid
  bookId       String             @map("book_id") @db.Uuid
  memberId     String             @map("member_id") @db.Uuid
  issueDate    DateTime           @default(now()) @map("issue_date")
  returnDate   DateTime?          @map("return_date")
  returnedAt   DateTime?          @map("returned_at")
  status       LibraryIssueStatus @default(ISSUED)
  createdById  String             @map("created_by_id") @db.Uuid
  returnedById String?            @map("returned_by_id") @db.Uuid
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book       LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  member     LibraryMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdBy  User          @relation("LibraryIssueCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  returnedBy User?         @relation("LibraryIssueReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([bookId])
  @@index([memberId])
  @@index([status])
  @@index([createdById])
  @@index([returnedById])
  @@map("library_issues")
}

model ParentGuardian {
