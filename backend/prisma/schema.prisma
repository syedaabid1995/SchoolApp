generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  STANDARD
  PREMIUM
}

enum SchoolOnboardingStatus {
  DRAFT
  SETUP_IN_PROGRESS
  READY_FOR_REVIEW
  ACTIVE
  BLOCKED
}

model School {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  code             String           @unique
  subdomain        String?          @unique
  domainUrl        String?          @map("domain_url")
  status           SchoolStatus     @default(ACTIVE)
  subscriptionPlan SubscriptionPlan @map("subscription_plan")
  onboardingStatus SchoolOnboardingStatus @default(DRAFT) @map("onboarding_status")
  lastLoginAt      DateTime?        @map("last_login_at")
  activeUsersCount Int              @default(0) @map("active_users_count")
  statusReason     String?          @map("status_reason")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  users                          User[]
  academicYears                  AcademicYear[]
  classes                        Class[]
  classSections                  ClassSection[]
  sections                       Section[]
  subjects                       Subject[]
  classRooms                     ClassRoom[]
  timePeriods                    TimePeriod[]
  assignSubjects                 AssignSubject[]
  classTeachers                  ClassTeacher[]
  classRoutines                  ClassRoutine[]
  students                       Student[]
  parentGuardians                ParentGuardian[]
  studentEnrollments             StudentEnrollment[]
  studentAttendances             StudentAttendance[]
  attendanceHolidays             AttendanceHoliday[]
  studentGroups                  StudentGroup[]
  studentCategories              StudentCategory[]
  studentPromotions              StudentPromotion[]
  studentPromotionHistories      StudentPromotionHistory[]
  disabledStudentLogs            DisabledStudentLog[]
  studentDocuments               StudentDocument[]
  studentTimelines               StudentTimeline[]
  studentSiblings                StudentSibling[]
  studentImportLogs              StudentImportLog[]
  teachers                       TeacherProfile[]
  teacherOnboardings             TeacherOnboarding[]
  departments                    Department[]
  designations                   Designation[]
  staffDocuments                 StaffDocument[]
  staffTimelines                 StaffTimeline[]
  staffAttendances               StaffAttendance[]
  staffAttendanceHolidays        StaffAttendanceHoliday[]
  payrolls                       Payroll[]
  payrollPayments                PayrollPayment[]
  importJobs                     ImportJob[]
  faceProfiles                   FaceProfile[]
  attendancePeriods              AttendancePeriod[]
  attendanceSessions             AttendanceSession[]
  studentAttendanceSessions      StudentAttendanceSession[]
  teacherSelfAttendances         TeacherSelfAttendance[]
  teacherLeaveRequests           TeacherLeaveRequest[]
  leaveTypes                     LeaveType[]
  leaveDefines                   LeaveDefine[]
  leaveApplications              LeaveApplication[]
  leaveBalances                  LeaveBalance[]
  leaveStatusHistories           LeaveStatusHistory[]
  teacherAttendanceSubstitutions TeacherAttendanceSubstitution[]
  timetableVersions              TimetableVersion[]
  timetableEntries               TimetableEntry[]
  exams                          Exam[]
  examGradingSetting             ExamGradingSetting?
  examTypes                      ExamTypeConfig[]
  examCenters                    ExamCenter[]
  examRooms                      ExamRoom[]
  examSeatingAllocations         ExamSeatingAllocation[]
  examInvigilatorAssignments     ExamInvigilatorAssignment[]
  themes                         Theme[]
  featureFlagOverrides           FeatureFlagOverride[]
  configOverrides                TenantConfigOverride[]
  notificationLogs               NotificationLog[]
  backupJobs                     BackupJob[]
  subscription                   Subscription?
  usageCounter                   UsageCounter?
  otpCodes                       OtpCode[]
  consentRecords                 ConsentRecord[]
  dataExportJobs                 DataExportJob[]
  dataDeletionJobs               DataDeletionJob[]
  complianceJobStatusHistories   ComplianceJobStatusHistory[]
  auditExports                   AuditExport[]
  supportTickets                 SupportTicket[]
  supportTicketComments          TicketComment[]
  messagingConfigs               SchoolMessagingConfig[]
  systemSetting                  SchoolSystemSetting?
  transferRequestsFrom           StudentTransferRequest[]        @relation("TransferFromSchool")
  transferRequestsTo             StudentTransferRequest[]        @relation("TransferToSchool")
  employeeRolePermissions        EmployeeRolePermission[]
  employeeUserPermissions        EmployeeUserPermission[]
  refreshSessions                RefreshSession[]
  passwordResetTokens            PasswordResetToken[]
  mfaChallenges                  MfaChallenge[]
  totpCredentials                TotpCredential[]
  totpBackupCodes                TotpBackupCode[]
  dormitories                    Dormitory[]
  dormitoryRoomTypes             DormitoryRoomType[]
  dormitoryRooms                 DormitoryRoom[]
  studentDormitoryAssignments    StudentDormitoryAssignment[]
  transportRoutes                TransportRoute[]
  transportVehicles              TransportVehicle[]
  transportRouteVehicles         TransportRouteVehicle[]
  studentTransportAssignments    StudentTransportAssignment[]
  homeworks                      Homework[]
  homeworkEvaluations            HomeworkEvaluation[]
  libraryBookCategories          LibraryBookCategory[]
  libraryBooks                   LibraryBook[]
  libraryMembers                 LibraryMember[]
  libraryIssues                  LibraryIssue[]
  feeParticulars                 FeeParticular[]
  feeTypes                       FeeType[]
  feeStructures                  FeeStructure[]
  studentFeeAssignments          StudentFeeAssignment[]
  feeInvoices                    FeeInvoice[]
  feePayments                    FeePayment[]
  feeReceipts                    FeeReceipt[]
  feePaymentAllocations          FeePaymentAllocation[]
  feeDiscounts                   FeeDiscount[]
  feeFines                       FeeFine[]
  feeLedgers                     FeeLedger[]
  feeNotifications               FeeNotification[]
  numberSequences                NumberSequence[]
  onboardingChecklist            SchoolOnboardingChecklist[]

  @@map("schools")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  STAFF
  PARENT
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  schoolId           String?    @map("school_id") @db.Uuid
  email              String
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  mfaMethod          String?    @map("mfa_method")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school                                 School?                         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  roles                                  UserRole[]
  parentProfiles                         ParentProfile[]
  teacherProfile                         TeacherProfile?
  bankDetails                            UserBankDetails?
  importJobs                             ImportJob[]
  faceProfilesCreated                    FaceProfile[]                   @relation("FaceProfileCreatedBy")
  faceProfilesApproved                   FaceProfile[]                   @relation("FaceProfileApprovedBy")
  attendanceSessions                     AttendanceSession[]
  attendanceAudits                       AttendanceAudit[]               @relation("AttendanceAuditActor")
  markModerations                        MarkModeration[]
  markRevaluations                       MarkRevaluation[]
  featureFlagOverrides                   FeatureFlagOverride[]
  notificationLogs                       NotificationLog[]
  backupRequests                         BackupJob[]
  restoreApprovals                       RestoreJob[]                    @relation("RestoreApprovedBy")
  restoreRequests                        RestoreJob[]                    @relation("RestoreRequestedBy")
  dataExportJobs                         DataExportJob[]
  dataExportReviews                      DataExportJob[]                 @relation("DataExportReviewedBy")
  dataDeletionRequests                   DataDeletionJob[]               @relation("DeletionRequestedBy")
  dataDeletionApprovals                  DataDeletionJob[]               @relation("DeletionApprovedBy")
  dataDeletionReviews                    DataDeletionJob[]               @relation("DeletionReviewedBy")
  complianceJobStatusHistories           ComplianceJobStatusHistory[]    @relation("ComplianceStatusHistoryActor")
  auditLogs                              AuditLog[]
  auditExports                           AuditExport[]
  supportTickets                         SupportTicket[]                 @relation("SupportTicketCreatedBy")
  assignedSupportTickets                 SupportTicket[]                 @relation("SupportTicketAssignedTo")
  supportTicketComments                  TicketComment[]                 @relation("SupportTicketCommentAuthor")
  transferRequestsCreated                StudentTransferRequest[]        @relation("TransferRequestedBy")
  transferRequestsDecided                StudentTransferRequest[]        @relation("TransferDecidedBy")
  studentAttendanceSessionsCreated       StudentAttendanceSession[]      @relation("StudentAttendanceSessionCreatedBy")
  studentAttendanceSessionsLocked        StudentAttendanceSession[]      @relation("StudentAttendanceSessionLockedBy")
  teacherSelfAttendancesCreated          TeacherSelfAttendance[]         @relation("TeacherSelfAttendanceCreatedBy")
  teacherSelfAttendancesOverridden       TeacherSelfAttendance[]         @relation("TeacherSelfAttendanceOverriddenBy")
  teacherLeaveRequestsReviewed           TeacherLeaveRequest[]           @relation("TeacherLeaveRequestReviewedBy")
  leaveApplicationsReviewed              LeaveApplication[]              @relation("LeaveApplicationReviewedBy")
  leaveAttachmentsUploaded               LeaveAttachment[]               @relation("LeaveAttachmentUploadedBy")
  leaveStatusHistoriesChanged            LeaveStatusHistory[]            @relation("LeaveStatusHistoryChangedBy")
  teacherAttendanceSubstitutionsCreated  TeacherAttendanceSubstitution[] @relation("TeacherAttendanceSubstitutionCreatedBy")
  teacherAttendanceSubstitutionsCanceled TeacherAttendanceSubstitution[] @relation("TeacherAttendanceSubstitutionCanceledBy")
  timetableVersionsCreated               TimetableVersion[]
  employeeUserPermissions                EmployeeUserPermission[]
  refreshSessions                        RefreshSession[]
  passwordResetTokens                    PasswordResetToken[]
  mfaChallenges                          MfaChallenge[]
  totpCredential                         TotpCredential?
  totpBackupCodes                        TotpBackupCode[]
  studentDocumentsUploaded               StudentDocument[]               @relation("StudentDocumentUploadedBy")
  studentTimelinesCreated                StudentTimeline[]               @relation("StudentTimelineCreatedBy")
  studentImportLogsCreated               StudentImportLog[]              @relation("StudentImportLogCreatedBy")
  staffDocumentsUploaded                 StaffDocument[]                 @relation("StaffDocumentUploadedBy")
  staffTimelinesCreated                  StaffTimeline[]                 @relation("StaffTimelineCreatedBy")
  staffAttendancesMarked                 StaffAttendance[]               @relation("StaffAttendanceMarkedBy")
  staffAttendanceHolidaysCreated         StaffAttendanceHoliday[]        @relation("StaffAttendanceHolidayCreatedBy")
  schoolOnboardingChecklistCompletions   SchoolOnboardingChecklist[]     @relation("SchoolOnboardingChecklistCompletedBy")
  payrollsGenerated                      Payroll[]                       @relation("PayrollGeneratedBy")
  payrollPaymentsRecorded                PayrollPayment[]                @relation("PayrollPaymentRecordedBy")
  homeworksCreated                       Homework[]                      @relation("HomeworkCreatedBy")
  homeworksEvaluated                     Homework[]                      @relation("HomeworkEvaluatedBy")
  homeworkEvaluations                    HomeworkEvaluation[]            @relation("HomeworkEvaluationEvaluatedBy")
  libraryIssuesCreated                   LibraryIssue[]                  @relation("LibraryIssueCreatedBy")
  libraryIssuesReturned                  LibraryIssue[]                  @relation("LibraryIssueReturnedBy")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  schoolId   String?   @map("school_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  deviceName String?   @map("device_name")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdIp String?   @map("created_ip")
  userAgent String?   @map("user_agent")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model MfaChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  schoolId    String?   @map("school_id") @db.Uuid
  otpHash     String    @map("otp_hash")
  purpose     String    @default("LOGIN")
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdIp   String?   @map("created_ip")
  userAgent   String?   @map("user_agent")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([expiresAt])
  @@index([verifiedAt])
  @@map("mfa_challenges")
}

model TotpCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  schoolId        String?   @map("school_id") @db.Uuid
  encryptedSecret String    @map("encrypted_secret")
  issuer          String
  label           String
  enabledAt       DateTime? @map("enabled_at")
  disabledAt      DateTime? @map("disabled_at")
  setupStartedAt  DateTime  @default(now()) @map("setup_started_at")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([enabledAt])
  @@index([disabledAt])
  @@map("totp_credentials")
}

model TotpBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  schoolId  String?   @map("school_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdIp String?   @map("created_ip")
  userAgent String?   @map("user_agent")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([schoolId])
  @@index([usedAt])
  @@map("totp_backup_codes")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmployeeRolePermission {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  roleName       RoleName @map("role_name")
  permissionCode String   @map("permission_code")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, roleName, permissionCode])
  @@index([schoolId, roleName])
  @@map("employee_role_permissions")
}

model EmployeeUserPermission {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  permissionCode String   @map("permission_code")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, permissionCode])
  @@index([schoolId, userId])
  @@map("employee_user_permissions")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school                         School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms                          Term[]
  exams                          Exam[]
  classes                        Class[]
  subjects                       Subject[]
  students                       Student[]
  studentEnrollments             StudentEnrollment[]
  studentAttendances             StudentAttendance[]
  attendanceHolidays             AttendanceHoliday[]
  studentPromotionsFrom          StudentPromotion[]              @relation("PromotionFromSession")
  studentPromotionsTo            StudentPromotion[]              @relation("PromotionToSession")
  studentPromotionHistoriesFrom  StudentPromotionHistory[]       @relation("PromotionHistoryFromSession")
  studentPromotionHistoriesTo    StudentPromotionHistory[]       @relation("PromotionHistoryToSession")
  studentImportLogs              StudentImportLog[]
  teacherAttendanceSubstitutions TeacherAttendanceSubstitution[]
  timetableVersions              TimetableVersion[]
  timetableEntries               TimetableEntry[]
  feeParticulars                 FeeParticular[]
  feeTypes                       FeeType[]
  feeStructures                  FeeStructure[]
  studentFeeAssignments          StudentFeeAssignment[]
  feeInvoices                    FeeInvoice[]
  feePayments                    FeePayment[]
  feeReceipts                    FeeReceipt[]
  feePaymentAllocations          FeePaymentAllocation[]
  feeDiscounts                   FeeDiscount[]
  feeFines                       FeeFine[]
  feeLedgers                     FeeLedger[]
  feeNotifications               FeeNotification[]
  numberSequences                NumberSequence[]

  @@index([schoolId])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@map("terms")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school                         School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear                   AcademicYear?                   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  sections                       Section[]
  classSections                  ClassSection[]
  subjects                       Subject[]
  assignSubjects                 AssignSubject[]
  classTeachers                  ClassTeacher[]
  classRoutines                  ClassRoutine[]
  students                       Student[]
  studentEnrollments             StudentEnrollment[]
  studentAttendances             StudentAttendance[]
  attendanceHolidays             AttendanceHoliday[]
  studentImportLogs              StudentImportLog[]
  exams                          Exam[]
  examPapers                     ExamPaper[]
  teacherAssignments             TeacherClassAssignment[]
  studentAttendanceSessions      StudentAttendanceSession[]
  teacherAttendanceSubstitutions TeacherAttendanceSubstitution[]
  timetableEntries               TimetableEntry[]
  homeworks                      Homework[]
  feeStructures                  FeeStructure[]
  feeInvoices                    FeeInvoice[]
  feeDiscounts                   FeeDiscount[]
  feeAssignments                 StudentFeeAssignment[]

  @@index([schoolId])
  @@index([academicYearId])
  @@map("classes")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String?  @map("class_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school                         School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class                          Class?                          @relation(fields: [classId], references: [id], onDelete: Cascade)
  classSections                  ClassSection[]
  assignSubjects                 AssignSubject[]
  classTeachers                  ClassTeacher[]
  classRoutines                  ClassRoutine[]
  students                       Student[]
  studentEnrollments             StudentEnrollment[]
  studentAttendances             StudentAttendance[]
  attendanceHolidays             AttendanceHoliday[]
  studentImportLogs              StudentImportLog[]
  exams                          Exam[]
  studentAttendanceSessions      StudentAttendanceSession[]
  teacherAssignments             TeacherClassAssignment[]
  teacherAttendanceSubstitutions TeacherAttendanceSubstitution[]
  timetableEntries               TimetableEntry[]
  homeworks                      Homework[]
  feeStructures                  FeeStructure[]
  feeInvoices                    FeeInvoice[]
  feeDiscounts                   FeeDiscount[]
  feeAssignments                 StudentFeeAssignment[]

  @@unique([classId, name])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

model ClassSection {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId])
  @@index([schoolId])
  @@index([sectionId])
  @@map("class_sections")
}

enum SubjectType {
  THEORY
  PRACTICAL
}

model Subject {
  id             String      @id @default(uuid()) @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  classId        String?     @map("class_id") @db.Uuid
  academicYearId String?     @map("academic_year_id") @db.Uuid
  name           String
  code           String?
  type           SubjectType @default(THEORY)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class?                     @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear       AcademicYear?              @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  examPapers         ExamPaper[]
  teacherAssignments TeacherSubjectAssignment[]
  timetableEntries   TimetableEntry[]
  assignSubjects     AssignSubject[]
  classRoutines      ClassRoutine[]
  homeworks          Homework[]
  libraryBooks       LibraryBook[]

  @@unique([schoolId, name, classId, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([academicYearId])
  @@map("subjects")
}

enum TimePeriodType {
  CLASS_TIME
  EXAM_TIME
  BREAK
}

model ClassRoom {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  roomNumber String   @map("room_number")
  capacity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoutines ClassRoutine[]

  @@unique([schoolId, roomNumber])
  @@index([schoolId])
  @@map("class_rooms")
}

model TimePeriod {
  id        String         @id @default(uuid()) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  type      TimePeriodType
  name      String
  startTime String         @map("start_time")
  endTime   String         @map("end_time")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoutines ClassRoutine[]

  @@unique([schoolId, type, name])
  @@index([schoolId])
  @@map("time_periods")
}

model AssignSubject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("assign_subjects")
}

model ClassTeacher {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId])
  @@index([schoolId])
  @@index([teacherId])
  @@map("class_teachers")
}

model ClassRoutine {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  sectionId    String   @map("section_id") @db.Uuid
  timePeriodId String   @map("time_period_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  subjectId    String   @map("subject_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  classRoomId  String?  @map("class_room_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod     @relation(fields: [timePeriodId], references: [id], onDelete: Cascade)
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classRoom  ClassRoom?     @relation(fields: [classRoomId], references: [id], onDelete: SetNull)

  @@unique([schoolId, classId, sectionId, dayOfWeek, timePeriodId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classRoomId])
  @@map("class_routines")
}

enum StudentStatus {
  ENROLLED
  TRANSFERRED
  EXITED
  DISABLED
}

enum StudentPromotionResult {
  PASS
  FAIL
}

enum HomeworkQualityStatus {
  GOOD
  NOT_GOOD
}

enum HomeworkCompletionStatus {
  COMPLETED
  NOT_COMPLETED
}

enum LibraryMemberType {
  STUDENT
  TEACHER
  STAFF
}

enum LibraryIssueStatus {
  ISSUED
  RETURNED
}

enum TransferRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Student {
  id                   String        @id @default(uuid()) @db.Uuid
  schoolId             String        @map("school_id") @db.Uuid
  academicSessionId    String?       @map("academic_session_id") @db.Uuid
  classId              String?       @map("class_id") @db.Uuid
  sectionId            String?       @map("section_id") @db.Uuid
  studentGroupId       String?       @map("student_group_id") @db.Uuid
  studentCategoryId    String?       @map("student_category_id") @db.Uuid
  admissionNo          String        @map("admission_no")
  rollNo               String?       @map("roll_no")
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  fullName             String        @map("full_name")
  dob                  DateTime?     @map("dob")
  gender               String?       @map("gender")
  bloodGroup           String?       @map("blood_group")
  religion             String?
  caste                String?
  category             String?
  email                String?
  phone                String?
  admissionDate        DateTime?     @map("admission_date")
  height               Decimal?      @db.Decimal(6, 2)
  weight               Decimal?      @db.Decimal(6, 2)
  photoUrl             String?       @map("photo_url")
  fatherName           String?       @map("father_name")
  fatherOccupation     String?       @map("father_occupation")
  fatherPhone          String?       @map("father_phone")
  fatherPhotoUrl       String?       @map("father_photo_url")
  motherName           String?       @map("mother_name")
  motherOccupation     String?       @map("mother_occupation")
  motherPhone          String?       @map("mother_phone")
  motherPhotoUrl       String?       @map("mother_photo_url")
  guardianName         String?       @map("guardian_name")
  guardianRelationship String?       @map("guardian_relationship")
  guardianPhotoUrl     String?       @map("guardian_photo_url")
  parentPhone          String?       @map("parent_phone")
  parentEmail          String?       @map("parent_email")
  presentAddress       String?       @map("present_address")
  permanentAddress     String?       @map("permanent_address")
  addressLine1         String?       @map("address_line1")
  addressLine2         String?       @map("address_line2")
  city                 String?       @map("city")
  state                String?       @map("state")
  pincode              String?       @map("pincode")
  emergencyContact     String?       @map("emergency_contact")
  medicalConditions    String?       @map("medical_conditions")
  allergies            String?       @map("allergies")
  doctorContact        String?       @map("doctor_contact")
  docBirthCert         String?       @map("doc_birth_cert")
  docTransferCert      String?       @map("doc_transfer_cert")
  docAadhaar           String?       @map("doc_aadhaar")
  docReportCard        String?       @map("doc_report_card")
  status               StudentStatus @default(ENROLLED)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  school                   School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession          AcademicYear?                @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  class                    Class?                       @relation(fields: [classId], references: [id], onDelete: SetNull)
  section                  Section?                     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  studentGroup             StudentGroup?                @relation(fields: [studentGroupId], references: [id], onDelete: SetNull)
  studentCategory          StudentCategory?             @relation(fields: [studentCategoryId], references: [id], onDelete: SetNull)
  guardians                ParentGuardian[]
  enrollments              StudentEnrollment[]
  attendance               StudentAttendance[]
  promotionHistories       StudentPromotionHistory[]
  disabledLogs             DisabledStudentLog[]
  documents                StudentDocument[]
  timelines                StudentTimeline[]
  siblings                 StudentSibling[]             @relation("StudentSiblingOwner")
  siblingOf                StudentSibling[]             @relation("StudentSiblingLinked")
  parentLinks              StudentParent[]
  statusEvents             StudentStatusHistory[]
  transferRequests         StudentTransferRequest[]
  faceProfile              FaceProfile?
  attendanceRecords        AttendanceRecord[]
  studentAttendanceRecords StudentAttendanceRecord[]
  marks                    Mark[]
  photos                   StudentPhoto[]
  dormitoryAssignments     StudentDormitoryAssignment[]
  transportAssignments     StudentTransportAssignment[]
  homeworkEvaluations      HomeworkEvaluation[]
  libraryMemberships       LibraryMember[]
  feeAssignments           StudentFeeAssignment[]
  feeInvoices              FeeInvoice[]
  feePayments              FeePayment[]
  feeReceipts              FeeReceipt[]
  feePaymentAllocations    FeePaymentAllocation[]
  feeDiscounts             FeeDiscount[]
  feeLedgers               FeeLedger[]
  feeNotifications         FeeNotification[]
  examSeatingAllocations   ExamSeatingAllocation[]

  @@unique([schoolId, admissionNo])
  @@index([academicSessionId])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([studentGroupId])
  @@index([studentCategoryId])
  @@map("students")
}

model Dormitory {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  type        String
  intake      Int
  address     String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms       DormitoryRoom[]
  assignments StudentDormitoryAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("dormitories")
}

model DormitoryRoomType {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms  DormitoryRoom[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("dormitory_room_types")
}

model DormitoryRoom {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  dormitoryId String   @map("dormitory_id") @db.Uuid
  roomTypeId  String   @map("room_type_id") @db.Uuid
  roomNumber  String   @map("room_number")
  bedCount    Int      @map("bed_count")
  costPerBed  Decimal  @map("cost_per_bed") @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dormitory   Dormitory                    @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  roomType    DormitoryRoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  assignments StudentDormitoryAssignment[]

  @@unique([schoolId, dormitoryId, roomNumber, roomTypeId])
  @@index([schoolId])
  @@index([dormitoryId])
  @@index([roomTypeId])
  @@map("dormitory_rooms")
}

model StudentDormitoryAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  dormitoryId String    @map("dormitory_id") @db.Uuid
  roomId      String?   @map("room_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  vacatedAt   DateTime? @map("vacated_at")
  active      Boolean   @default(true)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dormitory Dormitory      @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  room      DormitoryRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId])
  @@index([dormitoryId])
  @@index([roomId])
  @@index([active])
  @@map("student_dormitory_assignments")
}

model TransportRoute {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  title     String
  fare      Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school             School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicleAssignments TransportRouteVehicle[]
  studentAssignments StudentTransportAssignment[]
  feeAssignments     StudentFeeAssignment[]

  @@unique([schoolId, title])
  @@index([schoolId])
  @@map("transport_routes")
}

model TransportVehicle {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  vehicleNumber String   @map("vehicle_number")
  vehicleModel  String   @map("vehicle_model")
  yearMade      Int?     @map("year_made")
  driverName    String   @map("driver_name")
  driverLicense String   @map("driver_license")
  driverContact String   @map("driver_contact")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school             School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeAssignments   TransportRouteVehicle[]
  studentAssignments StudentTransportAssignment[]

  @@unique([schoolId, vehicleNumber])
  @@index([schoolId])
  @@map("transport_vehicles")
}

model TransportRouteVehicle {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route   TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([routeId, vehicleId])
  @@index([schoolId])
  @@index([routeId])
  @@index([vehicleId])
