  REJECTED
  RUNNING
  COMPLETED
  FAILED
}

model BackupJob {
  id            String       @id @default(uuid()) @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  status        BackupStatus @default(REQUESTED)
  storagePath   String?      @map("storage_path")
  requestedById String       @map("requested_by_id") @db.Uuid
  reason        String?
  startedAt     DateTime?    @map("started_at")
  finishedAt    DateTime?    @map("finished_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedBy User         @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  restores    RestoreJob[]

  @@index([schoolId])
  @@index([requestedById])
  @@map("backup_jobs")
}

model RestoreJob {
  id            String        @id @default(uuid()) @db.Uuid
  backupId      String        @map("backup_id") @db.Uuid
  status        RestoreStatus @default(REQUESTED)
  approvedById  String?       @map("approved_by_id") @db.Uuid
  requestedById String        @map("requested_by_id") @db.Uuid
  reason        String?
  startedAt     DateTime?     @map("started_at")
  finishedAt    DateTime?     @map("finished_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  backup      BackupJob @relation(fields: [backupId], references: [id], onDelete: Cascade)
  approvedBy  User?     @relation("RestoreApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  requestedBy User      @relation("RestoreRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([backupId])
  @@index([approvedById])
  @@index([requestedById])
  @@map("restore_jobs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  actorRole   String   @map("actor_role")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@map("audit_logs")
}

model AuditExport {
  id            String    @id @default(uuid()) @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  schoolId      String?   @map("school_id") @db.Uuid
  format        String
  filters       Json?
  reason        String?
  status        String    @default("PENDING")
  rowCount      Int?      @map("row_count")
  fileUrl       String?   @map("file_url")
  fileKey       String?   @map("file_key")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  school      School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
  @@map("audit_exports")
}

model Subscription {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @unique @map("school_id") @db.Uuid
  planId          String?   @map("plan_id") @db.Uuid
  planName        String    @map("plan_name")
  status          String    @default("ACTIVE")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  billingCycle    String    @default("MONTHLY") @map("billing_cycle")
  discountPercent Int       @default(0) @map("discount_percent")
  graceDays       Int       @default(15) @map("grace_days")
  paidAt          DateTime? @map("paid_at")
  nextDueAt       DateTime? @map("next_due_at")
  studentLimit    Int       @map("student_limit")
  teacherLimit    Int       @map("teacher_limit")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  school School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlanDef? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionPlanDef {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  status       String   @default("ACTIVE")
  priceCents   Int      @default(0) @map("price_cents")
  features     String[] @default([]) @map("features")
  studentLimit Int      @map("student_limit")
  teacherLimit Int      @map("teacher_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  permissions   SubscriptionPlanPermission[]

  @@map("subscription_plans")
}

model SubscriptionPlanPermission {
  id             String   @id @default(uuid()) @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  permissionCode String   @map("permission_code")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlanDef @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionCode])
  @@index([planId])
  @@map("subscription_plan_permissions")
}

model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @map("school_id") @db.Uuid
  students  Int      @default(0)
  teachers  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("usage_counters")
}

model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  phone       String
  purpose     String    @default("PARENT_LOGIN")
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([phone])
  @@map("otp_codes")
}

enum ConsentType {
  BIOMETRIC
  DATA_PROCESSING
}

model ConsentDocument {
  id        String      @id @default(uuid()) @db.Uuid
  version   String
  type      ConsentType
  text      String
  createdAt DateTime    @default(now()) @map("created_at")

  records ConsentRecord[]

  @@unique([version, type])
  @@map("consent_documents")
}

model ConsentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  parentId    String    @map("parent_id") @db.Uuid
  documentId  String    @map("document_id") @db.Uuid
  status      String    @default("GRANTED")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent   ParentProfile   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  document ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([parentId])
  @@index([documentId])
  @@map("consent_records")
}

