# Copy to .env and replace every dummy value before running outside local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://schoolapp_user:schoolapp_password@localhost:5432/schoolapp_dev
JWT_SECRET=dummy_dev_jwt_secret_32_chars_minimum_change_me
TOTP_ENCRYPTION_KEY=dummy_totp_encryption_key_32_chars_minimum
AUTH_TWO_STEP_ENABLED=false
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,https://app.akademifyy.in
SCHOOL_PUBLIC_ROOT_DOMAIN=app.akademifyy.in
LOG_LEVEL=debug
ACADEMIFY_PROCESS_ROLE=all
RUN_API=true
RUN_WORKERS=true
RUN_SCHEDULERS=true
SHUTDOWN_GRACE_MS=30000

# Temporary staging/pilot load testing only. Never enable by default.
# Requests must include x-load-test-key with this secret to bypass only the global rate limiter.
# This does not bypass authentication, authorization, login/MFA rate limits, or write guards.
LOAD_TESTING_ENABLED=false
LOAD_TESTING_SECRET=
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/runtime
STORAGE_LEGACY_LOCAL_UPLOADS_READ_ENABLED=true
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
SIGNED_URL_EXPIRES_SECONDS=900
REDIS_URL=redis://localhost:6379
REDIS_CACHE_ENABLED=true
REDIS_AUTHZ_CACHE_ENABLED=true
REDIS_CACHE_DEBUG=false
REDIS_CACHE_DASHBOARD_ENABLED=true
REDIS_CACHE_ANALYTICS_ENABLED=true
REDIS_CACHE_SCHOOLS_ENABLED=true
REDIS_CACHE_STUDENTS_ENABLED=true
REDIS_CACHE_TEACHERS_ENABLED=true
REDIS_CACHE_ATTENDANCE_ENABLED=true
REDIS_CACHE_NOTIFICATIONS_ENABLED=true
REDIS_CACHE_SUBSCRIPTIONS_ENABLED=true
REDIS_CACHE_THEMES_ENABLED=true
REDIS_CACHE_AUDIT_LOGS_ENABLED=true
REDIS_CACHE_MARKS_ENABLED=true
METRICS_ENABLED=true
ATTENDANCE_ENABLED=true
TEACHER_SELF_ATTENDANCE_ENABLED=true
LEAVE_BASIC_ENABLED=true
WHATSAPP_FALLBACK_TO=0000000000
GOOGLE_SMTP_HOST=smtp-relay.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_FROM_NAME=Akademifyy
GOOGLE_SMTP_FROM_EMAIL=no-reply@akademifyy.in
GOOGLE_SMTP_REPLY_TO=support@akademifyy.in
AWS_ACCESS_KEY_ID=dummy-access-key-id
AWS_SECRET_ACCESS_KEY=dummy-secret-access-key-change-me
AWS_REGION=us-east-1
AWS_S3_BUCKET=dummy-schoolapp-bucket
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=dummy-schoolapp-bucket
S3_ACCESS_KEY_ID=dummy-access-key-id
S3_SECRET_ACCESS_KEY=dummy-secret-access-key-change-me
S3_FORCE_PATH_STYLE=false
