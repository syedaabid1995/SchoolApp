[Unit]
Description=Synchronize SAAPT SSH block list with nftables
Before=ssh.service saapt-ssh-action.service
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/saapt-ssh-alert
ExecStart=/home/deploy/.nvm/versions/node/v24.18.0/bin/node /opt/saapt-ssh-alert/ssh-firewall-sync.js
RemainAfterExit=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/saapt-ssh-alert
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
