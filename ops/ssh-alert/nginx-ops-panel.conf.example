# Install as the ops.saapttech.com TLS virtual host after replacing the VPN CIDR.
# Do not remove the deny rule until a trusted VPN/management range is configured.
server {
    listen 443 ssl http2;
    server_name ops.saapttech.com;

    # Configure certbot-managed certificate paths for ops.saapttech.com here.
    # ssl_certificate ...;
    # ssl_certificate_key ...;

    location / {
        allow REPLACE_WITH_SERVER_TEAM_VPN_CIDR;
        deny all;

        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host ops.saapttech.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
    }
}
