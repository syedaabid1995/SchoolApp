# Expose the panel by server IP only through TLS; Node itself remains loopback-only.
server {
    listen 80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 404; }
}

server {
    listen 4174 ssl;
    server_name 200.97.165.51;

    ssl_certificate /etc/letsencrypt-ops-ip/live/200.97.165.51/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-ops-ip/live/200.97.165.51/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host 200.97.165.51;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
    }
}
