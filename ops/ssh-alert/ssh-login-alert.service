[Unit]
Description=Email alerts for SAAPT SSH logins and repeated failures
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/saapt-ssh-alert
Environment=OPS_PUBLIC_URL=https://ops.saapttech.com
ExecStart=/home/deploy/.nvm/versions/node/v24.18.0/bin/node /opt/saapt-ssh-alert/ssh-login-alert.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/saapt-ssh-alert
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
