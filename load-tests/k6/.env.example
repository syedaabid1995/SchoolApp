ACADEMIFY_BASE_URL=https://api.yourdomain.com
ACADEMIFY_TEST_PROFILE=smoke
ACADEMIFY_TEST_MODE=vus

# Use a dedicated non-MFA load-test account with fake/staging data.
ACADEMIFY_SCHOOL_ADMIN_EMAIL=load-admin@example.com
ACADEMIFY_SCHOOL_ADMIN_PASSWORD=replace-with-test-password
ACADEMIFY_SCHOOL_CODE=DKS00005
ACADEMIFY_LOGIN_TYPE=admin

# Comma-separated endpoints relative to /api/v1.
# Start small. Add heavier endpoints only after the smoke test passes.
ACADEMIFY_READ_ENDPOINTS=/users/me,/notifications/summary

# Optional: fixed request-rate mode.
ACADEMIFY_RPS=20
ACADEMIFY_DURATION=5m
ACADEMIFY_PRE_ALLOCATED_VUS=10
ACADEMIFY_MAX_VUS=80

# Optional: tune pacing and diagnostics.
ACADEMIFY_MIN_SLEEP_SECONDS=0.5
ACADEMIFY_MAX_SLEEP_SECONDS=2
ACADEMIFY_ACCEPTED_STATUSES=200,204,304
ACADEMIFY_LOG_UNEXPECTED_RESPONSES=false

# Optional: set this when the staging/pilot API has LOAD_TESTING_ENABLED=true.
# The script sends it as x-load-test-key. Do not commit real secrets.
ACADEMIFY_LOAD_TEST_KEY=
