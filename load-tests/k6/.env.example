ACADEMIFY_BASE_URL=https://api.yourdomain.com
ACADEMIFY_TEST_PROFILE=smoke
ACADEMIFY_TEST_MODE=vus

# Use a dedicated non-MFA load-test account with fake/staging data.
ACADEMIFY_ADMIN_EMAIL=load-admin@example.com
ACADEMIFY_ADMIN_PASSWORD=replace-with-test-password
ACADEMIFY_SCHOOL_CODE=DKS00005
ACADEMIFY_LOGIN_TYPE=admin

# Optional authenticated realistic profile.
# smoke, stage1, stage2, stage3, stage4, realistic, stress.
ACADEMIFY_AUTH_PROFILE=smoke
ACADEMIFY_MIN_THINK_SECONDS=1
ACADEMIFY_MAX_THINK_SECONDS=5

# Optional user pool. This is useful when running from distributed generators.
# Do not commit real credentials.
# ACADEMIFY_TEST_USERS_JSON=[{"email":"load-admin@example.com","password":"replace-with-test-password","schoolCode":"DKS00005","loginType":"admin"}]

# Attendance write fixture. Use a dedicated test school/class/student set only.
ACADEMIFY_ATTENDANCE_SUBMIT_ENABLED=true
ACADEMIFY_ATTENDANCE_CLASS_ID=
ACADEMIFY_ATTENDANCE_SECTION_ID=
ACADEMIFY_ATTENDANCE_STUDENT_IDS=
ACADEMIFY_ATTENDANCE_DATES=
ACADEMIFY_ATTENDANCE_RECORD_LIMIT=10
ACADEMIFY_ATTENDANCE_SUBMIT_LOCK=true

# Comma-separated endpoints relative to /api/v1.
# Start small. Add heavier endpoints only after the smoke test passes.
ACADEMIFY_READ_ENDPOINTS=/users/me,/notifications/summary

# Optional: fixed request-rate mode.
ACADEMIFY_RPS=20
ACADEMIFY_DURATION=5m
ACADEMIFY_PRE_ALLOCATED_VUS=10
ACADEMIFY_MAX_VUS=80

# Optional: tune pacing and diagnostics.
ACADEMIFY_MIN_SLEEP_SECONDS=0.5
ACADEMIFY_MAX_SLEEP_SECONDS=2
ACADEMIFY_ACCEPTED_STATUSES=200,204,304
ACADEMIFY_LOG_UNEXPECTED_RESPONSES=false

# Optional: set this when the staging/pilot API has LOAD_TESTING_ENABLED=true.
# The script sends it as x-load-test-key. Do not commit real secrets.
ACADEMIFY_LOAD_TEST_KEY=
