# Copy to .env for Docker Compose prod-lite. Replace every change_me value before using real data.
COMPOSE_PROJECT_NAME=academify

POSTGRES_DB=academify
POSTGRES_USER=academify
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql://academify:change_me_postgres_password@postgres:5432/academify

REDIS_URL=redis://redis:6379

BACKEND_PORT=4000
ADMIN_PORT=3001
NODE_ENV=production
PORT=4000
JWT_SECRET=change_me_jwt_secret_at_least_32_characters
TOTP_ENCRYPTION_KEY=change_me_totp_encryption_key_32_chars
AUTH_TWO_STEP_ENABLED=false
FRONTEND_URL=https://app.akademifyy.in
RAZORPAY_KEY_ID=rzp_live_change_me
RAZORPAY_KEY_SECRET=change_me_razorpay_secret
CORS_ORIGINS=https://app.akademifyy.in
SCHOOL_PUBLIC_ROOT_DOMAIN=app.akademifyy.in
LOG_LEVEL=info
ACADEMIFY_PROCESS_ROLE=api
RUN_API=true
RUN_WORKERS=false
RUN_SCHEDULERS=false
SHUTDOWN_GRACE_MS=30000

# Temporary staging/pilot load testing only. Never enable by default.
# Requests must include x-load-test-key with this secret to bypass only the global rate limiter.
# This does not bypass authentication, authorization, login/MFA rate limits, or write guards.
LOAD_TESTING_ENABLED=false
LOAD_TESTING_SECRET=
STORAGE_DRIVER=s3
STORAGE_LOCAL_ROOT=storage/runtime
STORAGE_LEGACY_LOCAL_UPLOADS_READ_ENABLED=false
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
SIGNED_URL_EXPIRES_SECONDS=900
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=change_me_bucket_name
S3_ACCESS_KEY_ID=change_me_s3_access_key_id
S3_SECRET_ACCESS_KEY=change_me_s3_secret_access_key
S3_FORCE_PATH_STYLE=false

# Optional local MinIO validation profile. Replace before using outside local testing.
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password

REDIS_CACHE_ENABLED=true
REDIS_AUTHZ_CACHE_ENABLED=true
REDIS_CACHE_DEBUG=false
METRICS_ENABLED=true

ATTENDANCE_ENABLED=true
TEACHER_SELF_ATTENDANCE_ENABLED=true
LEAVE_BASIC_ENABLED=true
WHATSAPP_FALLBACK_TO=0000000000
GOOGLE_SMTP_HOST=smtp-relay.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_FROM_NAME=Akademifyy
GOOGLE_SMTP_FROM_EMAIL=no-reply@akademifyy.in
GOOGLE_SMTP_REPLY_TO=support@akademifyy.in
GOOGLE_SMTP_EHLO_NAME=mail.akademifyy.in
GOOGLE_SMTP_DEBUG=false

AWS_ACCESS_KEY_ID=change_me_aws_access_key_id
AWS_SECRET_ACCESS_KEY=change_me_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=change_me_bucket_name
REKOGNITION_REGION=us-east-1
REKOGNITION_COLLECTION_PREFIX=schoolapp
REKOGNITION_AUTO_PRESENT_THRESHOLD=90
REKOGNITION_REVIEW_THRESHOLD=80

API_BASE_URL=http://backend-api:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.akademifyy.in/api/v1
NEXT_PUBLIC_SCHOOL_ROOT_DOMAIN=app.akademifyy.in
